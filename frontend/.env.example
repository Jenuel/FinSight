# Copy to .env.local for local development: cp .env.example .env.local
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined into the client bundle at BUILD
# time and are visible to anyone who loads the page. Never put a secret in one.
# (CLERK_SECRET_KEY has no NEXT_PUBLIC_ prefix precisely because it is a secret.)

# Which backend the app talks to: "api" or "local".
#   api   - Django REST API, authenticated with Clerk. Requires the Clerk key below.
#   local - fully offline demo on seeded localStorage data. No auth, no network.
NEXT_PUBLIC_DATA_SOURCE=api

# Base URL of the Django API. MUST include the /api suffix - ApiService appends
# paths like /accounts/ directly to it.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Clerk publishable key. REQUIRED when NEXT_PUBLIC_DATA_SOURCE=api - ClerkProvider
# cannot initialize without it and the build will fail.
# Get it from https://dashboard.clerk.com -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Clerk secret key - server-side only, never exposed to the browser.
# Set this in your hosting platform's dashboard, not in a committed file.
CLERK_SECRET_KEY=sk_test_your_key_here
