# Copy to .env for local development: cp .env.example .env
# Every value here is a placeholder. Never commit a real secret to this file.
#
# Security note: all security-sensitive settings default to their SAFE value in
# config/settings.py. Dev mode is something you opt INTO here, never out of.

# Django settings
# REQUIRED - the app refuses to boot without it. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Local development only. Leave unset/False everywhere else.
DEBUG=True

# Comma-separated. REQUIRED when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
LOG_LEVEL=INFO

# CORS settings
# CORS_ALLOW_ALL_ORIGINS is rejected when DEBUG=False - list origins explicitly.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated origins (scheme included) trusted for CSRF-protected POSTs.
# Only the Django admin needs this. In production set it to the backend's own
# public origin, e.g. https://<owner>-<space>.hf.space. Not needed locally.
CSRF_TRUSTED_ORIGINS=

# Clerk JWT authentication
# CLERK_JWKS_URL is REQUIRED when DEBUG=False.
# CLERK_ISSUER enables 'iss' verification; CLERK_AUTHORIZED_PARTIES enables 'azp'
# verification against your frontend origin(s). Set both in production.
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000

# Database configuration
# Takes precedence over the DB_* vars below. This is what Render/Supabase inject.
#   postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=

# Alternative to DATABASE_URL. If neither is set, Django falls back to local SQLite.
DB_HOST=
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432
